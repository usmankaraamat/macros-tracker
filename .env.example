# Edge Function secrets. Never prefix these with a client-facing name and never
# commit the filled file. Upload them with:
#   supabase secrets set --env-file supabase/.env.local --project-ref <project>

USDA_API_KEY=your_usda_key_here
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
